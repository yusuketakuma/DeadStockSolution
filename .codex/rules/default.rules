# default.rules
# Minimal safety rails for full-access, non-interactive runs.
# Decision order is: forbidden > prompt > allow

# ---- Absolute no-go ----
prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Never delete filesystem root. If you need cleanup, target a project subdir explicitly.",
    match = ["rm -rf /"],
)

prefix_rule(
    pattern = ["rm", "-rf", "--no-preserve-root", "/"],
    decision = "forbidden",
    justification = "Never delete filesystem root (no-preserve-root).",
    match = ["rm -rf --no-preserve-root /"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Sudo is blocked in Codex runs. If truly needed, do it manually outside Codex.",
    match = ["sudo ls"],
)

prefix_rule(
    pattern = ["shutdown"],
    decision = "forbidden",
    justification = "Shutdown is blocked.",
    match = ["shutdown -h now"],
)

prefix_rule(
    pattern = ["reboot"],
    decision = "forbidden",
    justification = "Reboot is blocked.",
    match = ["reboot"],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Filesystem formatting tools are blocked.",
    match = ["mkfs /dev/sda1"],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Raw disk writes are blocked.",
    match = ["dd if=/dev/zero of=/dev/sda"],
)

# ---- Guardrails (allow common dev commands explicitly; helps if org requirements get stricter later) ----
prefix_rule(
    pattern = [["git"]],
    decision = "allow",
    justification = "Git is allowed for normal dev workflows.",
    match = ["git status", "git diff", "git log -n 5"],
)

prefix_rule(
    pattern = [["pnpm", "npm", "node", "npx"]],
    decision = "allow",
    justification = "Node tooling is allowed for repo builds/tests.",
    match = ["pnpm -v", "pnpm lint", "npm -v", "node -v", "npx -v"],
)
