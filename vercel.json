{
  "framework": "vite",
  "installCommand": "sh scripts/vercel-install.sh || sh ../scripts/vercel-install.sh",
  "buildCommand": "sh scripts/vercel-build.sh || sh ../scripts/vercel-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview": true
    }
  },
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/matching-refresh/retry",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/upload-jobs/retry",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/openclaw-retries/run",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/monthly-reports/run",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/internal/dead-stock/archive-expired",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/daily-statistics/aggregate",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/internal/proposals/expire-stale",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/drug-master-sync/run",
      "schedule": "0 19 * * *"
    }
  ]
}
